# Copy this to .env locally or configure these values with your hosting provider.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/apok
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000

# Optional automatic booking notifications with Resend.
RESEND_API_KEY=re_your_resend_api_key
BOOKING_NOTIFICATION_EMAIL=admin@example.com
BOOKING_NOTIFICATION_FROM=APOK Bookings <bookings@yourdomain.store>
